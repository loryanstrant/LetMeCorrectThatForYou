---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AlphabetFilter from '../components/AlphabetFilter.astro';
import CorrectionCard from '../components/CorrectionCard.astro';
const corrections = (await getCollection('corrections')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const available = [...new Set(corrections.map(({ data }) => data.title.charAt(0).toUpperCase()))];
---
<BaseLayout current="corrections">
  <section class="hero">
    <p class="eyebrow">Words matter</p>
    <h1>A polite place for<br /><em>painfully precise</em> corrections.</h1>
    <p>You’re here because someone wanted to correct you but was too polite, so here we are… Find the right spelling, capitalisation or spacing, then share its direct link like a tiny grammatical hand grenade.</p>
    <div class="summary"><strong>{corrections.length}</strong><span>carefully documented corrections</span></div>
  </section>
  <section class="directory" id="corrections" aria-labelledby="directory-heading">
    <div class="section-head"><div><p class="eyebrow">The correction directory</p><h2 id="directory-heading">Find the correct term</h2></div></div>
    <AlphabetFilter available={available} total={corrections.length} />
    <div class="entries">{corrections.map(({ data }) => <CorrectionCard {...data} />)}</div>
  </section>
  <section class="story-network" aria-labelledby="story-network-heading">
    <div class="network-intro">
      <p class="eyebrow">Further fieldwork</p>
      <h2 id="story-network-heading">The “Get Your Story Straight” network</h2>
      <p>If you’re going to say something, be right about it. These fellow independent resources cover the parts of Microsoft’s story that deserve their own specialist paperwork.</p>
    </div>
    <div class="network-links">
      <a class="network-card" href="https://www.mscloudlogos.com/" target="_blank" rel="noopener noreferrer">
        <span class="network-name">Microsoft Cloud Logos</span>
        <span>Proper product logos, including historical versions and the visual evidence behind the identity crisis.</span>
        <span class="network-action">Inspect the logos <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span>
      </a>
      <a class="network-card" href="https://www.msrebrandregistry.com/" target="_blank" rel="noopener noreferrer">
        <span class="network-name">The Rebrand Registry</span>
        <span>Microsoft cloud product names, past and present, with the evidence behind every documented change.</span>
        <span class="network-action">Inspect the registry <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span>
      </a>
    </div>
  </section>
  <div class="copy-status" aria-live="polite"></div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((button) => button.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}#${button.dataset.anchor}`;
      try { await navigator.clipboard.writeText(url); button.textContent = 'Link copied ✓'; setTimeout(() => button.textContent = 'Copy direct link', 1800); }
      catch { location.hash = button.dataset.anchor || ''; }
    }));
    const revealTarget = () => { const id = decodeURIComponent(location.hash.slice(1)); if (!id) return; const target = document.getElementById(id); if (!target?.classList.contains('correction')) return; document.querySelector<HTMLButtonElement>('[data-letter="all"]')?.click(); target.classList.add('targeted'); target.scrollIntoView({ block: 'start' }); };
    addEventListener('hashchange', revealTarget); revealTarget();
  </script>
</BaseLayout>
