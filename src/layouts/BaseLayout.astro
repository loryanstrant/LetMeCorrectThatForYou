---
interface Props { title?: string; description?: string; current?: 'corrections' | 'about'; }
const { title = 'Let me correct that for you!', description = 'A polite place for painfully precise corrections.', current } = Astro.props;
const pageTitle = title === 'Let me correct that for you!' ? title : `${title} · Let me correct that for you!`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0d4776" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <title>{pageTitle}</title>
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">✓</span>
        <span><small>A helpful public service</small>Let me correct that for you!</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#corrections" aria-current={current === 'corrections' ? 'page' : undefined}>Corrections</a>
        <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        <a class="suggest" href="https://github.com/loryanstrant/LetMeCorrectThatForYou/issues/new?template=suggest-a-correction.yml">Suggest a correction <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>
  <main id="main-content"><slot /></main>
  <footer>
    <p><strong>Let me correct that for you!</strong><br /><span>A helpful public service for precise product names.</span></p>
    <p><a href="https://github.com/loryanstrant/LetMeCorrectThatForYou">View the project on GitHub <span aria-hidden="true">↗</span></a></p>
  </footer>
</body>
</html>
